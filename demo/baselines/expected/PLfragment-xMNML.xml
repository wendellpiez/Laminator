          ch="17"
          off="863"
          ext="44"/>
   <text cf="r01_excerpt r45_s r58_l r59_phr" off="863" ext="44">Dove-like sat'st brooding on the vast Abyss,</text>
   <end gi="phr"
        rID="r59_phr"
        L="22"
        ch="66"
        off="907"
        ext="44"/>
   <end gi="l" rID="r58_l" L="22" ch="71" off="907" ext="44"/>
