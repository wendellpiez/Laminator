                  gi="n">144</annotation>
   </start>
   <text cf="r1_excerpt r2_s r3_l">He manages to keep the upper hand</text>
   <end gi="l"
        rID="r3_l"
        L="2"
        ch="49"/>
   <text cf="r1_excerpt r2_s">
   </text>
   <start gi="l"
          rID="r4_l"
          L="3"
          ch="1">
      <annotation L="3"
                  ch="4"
                  gi="n">145</annotation>
   </start>
   <text cf="r1_excerpt r2_s r4_l">On his own farm.</text>
   <end gi="s"
        rID="r2_s"
        L="3"
        ch="29"/>
   <text cf="r1_excerpt r4_l">
   </text>
   <start gi="s"
          rID="r5_s"
          L="3"
          ch="33"/>
   <text cf="r1_excerpt r4_l r5_s">He's boss.</text>
   <end gi="s"
        rID="r5_s"
        L="3"
        ch="46"/>
   <text cf="r1_excerpt r4_l">
   </text>
   <start gi="s"
          rID="r6_s"
          L="3"
          ch="50"/>
   <text cf="r1_excerpt r4_l r6_s">But as to hens:</text>
   <end gi="l"
        rID="r4_l"
        L="3"
        ch="68"/>
   <text cf="r1_excerpt r6_s">
   </text>
   <start gi="l"
          rID="r7_l"
          L="4"
          ch="1">
      <annotation L="4"
                  ch="4"
                  gi="n">146</annotation>
   </start>
   <text cf="r1_excerpt r6_s r7_l">We fence our flowers in and the hens range.</text>
   <end gi="l"
        rID="r7_l"
        L="4"
        ch="56"/>
