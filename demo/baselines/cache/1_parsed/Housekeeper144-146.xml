   <text/>
   <start>[<name>l</name>
      <pad>
      </pad>
      <annotation>[<gi>n</gi>}<text>144</text>{]</annotation>}</start>
   <text>He manages to keep the upper hand</text>
   <end>{<name>l</name>]</end>
   <text>
   </text>
   <start>[<name>l</name>
      <pad>
      </pad>
      <annotation>[<gi>n</gi>}<text>145</text>{]</annotation>}</start>
   <text>On his own farm.</text>
   <end>{<name>s</name>]</end>
   <text>
   </text>
   <start>[<name>s</name>}</start>
   <text>He's boss.</text>
   <end>{<name>s</name>]</end>
   <text>
   </text>
   <start>[<name>s</name>}</start>
   <text>But as to hens:</text>
   <end>{<name>l</name>]</end>
   <text>
   </text>
   <start>[<name>l</name>
      <pad>
      </pad>
      <annotation>[<gi>n</gi>}<text>146</text>{]</annotation>}</start>
   <text>We fence our flowers in and the hens range.</text>
   <end>{<name>l</name>]</end>
